<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence
             http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">

    <persistence-unit name="hotelPU">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>ca.senecapolytechnic.application.apd545project.model.Reservation</class>
        <class>ca.senecapolytechnic.application.apd545project.model.Billing</class>
        <class>ca.senecapolytechnic.application.apd545project.model.AdminUser</class>
        <class>ca.senecapolytechnic.application.apd545project.model.AuditLog</class>
        <class>ca.senecapolytechnic.application.apd545project.model.Feedback</class>
        <class>ca.senecapolytechnic.application.apd545project.model.Guest</class>
        <class>ca.senecapolytechnic.application.apd545project.model.Hotel</class>
        <class>ca.senecapolytechnic.application.apd545project.model.Payment</class>
        <class>ca.senecapolytechnic.application.apd545project.model.Reservation</class>
        <class>ca.senecapolytechnic.application.apd545project.model.ReservationAddon</class>
        <class>ca.senecapolytechnic.application.apd545project.model.ReservationRoom</class>
        <class>ca.senecapolytechnic.application.apd545project.model.Room</class>
        <class>ca.senecapolytechnic.application.apd545project.model.ServiceAddon</class>
        <class>ca.senecapolytechnic.application.apd545project.model.Waitlist</class>

        <properties>
            <!-- H2 example config -->
            <property name="javax.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:h2:./database/appDB"/>
            <property name="javax.persistence.jdbc.user" value="sa"/>
            <property name="javax.persistence.jdbc.password" value=""/>
            <!--<property name="hibernate.dialect" value="org.hibernate.dialect.SQLiteDialect"/>-->
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!--<property name="hibernate.hbm2ddl.auto" value="create-drop"/> DEBUG-->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.temp.use_jdbc_metadata_defaults" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
